# ── LLM (required from M2 onwards) ────────────────────────────────────────
# Free Gemini key: https://aistudio.google.com/apikey
# Used for policy parsing (Flash), correlation grouping (Flash), and
# constraint extraction (Pro). All calls use structured responseSchema.
GEMINI_API_KEY=

# ── Polygon / Polymarket (optional, only for live order submission) ───────
# Any Polygon RPC works. Required only when EXECUTION_MODE=live.
POLYGON_RPC=https://polygon-rpc.com

# ── Wallet / Signing (optional, only for live execution) ──────────────────
# Para API key for non-custodial session signing. https://getpara.com
# Not required for DEMO_MODE=replay or EXECUTION_MODE=dry.
PARA_API_KEY=

# ── Orchestrator ──────────────────────────────────────────────────────────
BOT_HOST=127.0.0.1
BOT_PORT=8787
# Scan cadence in ms. 120000 = 2 minutes.
# Each cycle can emit several sign requests (one per arb leg), so keep this
# generous unless you are happy approving popups constantly.
SCAN_INTERVAL_MS=120000
# SQLite path for proposals / fills / positions / snapshots.
BOT_DB_PATH=./data/bot.db

# ── Demo mode ─────────────────────────────────────────────────────────────
# replay  → fixture-backed scanner (reproducible; emits the canned Trump/PA/GOP arb)
# live    → Gamma REST + CLOB REST live data feed
DEMO_MODE=replay

# ── Execution mode ────────────────────────────────────────────────────────
# dry   → emit sign requests + synthesize fills locally; no USDC moves
# live  → submit signed orders to Polymarket CLOB
EXECUTION_MODE=dry

# Disable the whole execute-after-propose path (useful for read-only monitoring).
EXECUTE_ENABLED=true

# ── Web app ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_BOT_URL=http://127.0.0.1:8787
# mock  → dashboard auto-approves every sign request (demo-friendly)
# click → user clicks Approve in the Approvals panel (mock signature, no chain)
# live  → Para-issued viem account signs real EIP-712 orders. Requires the
#         three NEXT_PUBLIC_PARA_* vars below. Off by default.
NEXT_PUBLIC_SIGNER_MODE=mock
# Para developer portal: https://developer.getpara.com
NEXT_PUBLIC_PARA_API_KEY=
# BETA (default) or PROD — match to the key's environment in the Para dashboard.
NEXT_PUBLIC_PARA_ENV=BETA
NEXT_PUBLIC_APP_NAME=Orca
# Optional override for the Polygon RPC viem uses in live-signer mode.
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
